# Copy to .env. Every value is optional; the demo runs with none of them.

# openFDA (free key: https://open.fda.gov/apis/authentication/). Without one, the public rate limit applies.
OPENFDA_API_KEY=

# ---- AI agents (see docs/AGENTS.md). Advisory only: rules run first, a gate checks the model, a pharmacist decides.
# Which provider the agents use at start-up: bedrock (default) | anthropic | openai-compatible | mock | none
#   mock = deterministic and offline, no key needed (good for a demo with no network). none = rules only.
# A judge can also pick the provider and model, and paste a key, on the AI Agents screen. A pasted key stays in server memory only.
LLM_PROVIDER=
# bedrock: Converse API through the default AWS credential chain (env keys, AWS_PROFILE, SSO, or an instance role)
AWS_REGION=us-west-2
AWS_PROFILE=
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# openai-compatible: OpenAI, Azure OpenAI, Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), vLLM
OPENAI_BASE_URL=
# the key is OPENAI_API_KEY (set in the voice section below; the same key serves both). Ollama and LM Studio need none.
OPENAI_MODEL=

# Server
API_PORT=4000
DATA_DIR=./data
# Show the demo accounts on the sign-in page and allow the SSO stand-in (1 = on)
LG_DEMO=1
# Pretend today is this date (YYYY-MM-DD). Empty = the real date.
TODAY=

# Voicemail voice (text-to-speech only; nothing is dialled).
# auto tries ElevenLabs -> OpenAI -> best macOS voice -> the browser's voice. No voice cloning.
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Force a macOS voice, e.g. "Ava (Premium)" after downloading it in System Settings > Accessibility > Spoken Content
MAC_VOICE=

# ---- Security (see docs/SECURITY.md). Pilot controls, not a compliance claim.
# Where the data key for encrypting patient fields comes from: env | file | kms. Empty = env when DATA_KEY is set, else file.
KEY_PROVIDER=
# env provider: a base64 32-byte key (openssl rand -base64 32). Empty = the file provider makes DATA_DIR/.keys/data.key (mode 0600).
DATA_KEY=
# env provider: older keys, comma separated, so rows written before a rotation still open
DATA_KEY_PREVIOUS=
# env provider, rotation only: the key you are rotating to (pnpm --filter @chimera-rx/api keys:rotate)
NEW_DATA_KEY=
# Send the session cookie over HTTPS only (1 = on). Turn on whenever a TLS proxy sits in front of the API.
COOKIE_SECURE=0
# Sign a user out after this many idle minutes (0 = off)
SESSION_IDLE_MINUTES=30
# Browser origins allowed to call the API cross-origin (comma separated). Empty = the local dev origins only.
CORS_ORIGINS=
# 1 when a trusted reverse proxy sets X-Forwarded-For (so login throttling sees the real client IP)
TRUST_PROXY=0
